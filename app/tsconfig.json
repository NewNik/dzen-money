{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "google-apps-script",
      "node"
    ]
  },
  "include": [
    "src",
    "tests"
  ]
}
